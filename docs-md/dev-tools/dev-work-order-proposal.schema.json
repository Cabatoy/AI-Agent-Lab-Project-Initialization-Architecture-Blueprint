{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HIC developer-only non-executable work order proposal v1",
  "description": "Transport envelope only. NEVER authorize model execution, PR publication or privileged changes. The local coordinator must fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "mode",
    "orderId",
    "source",
    "task",
    "review",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "version": {
      "const": "hic.dev-work-order.proposal/1"
    },
    "kind": {
      "const": "DeveloperWorkOrderProposal"
    },
    "mode": {
      "const": "review-only"
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "queueIssue",
        "issueNumber",
        "issueUpdatedAt"
      ],
      "properties": {
        "repository": {
          "const": "Cabatoy/AI-Agent-Lab-Project-Initialization-Architecture-Blueprint"
        },
        "queueIssue": {
          "const": 75
        },
        "issueNumber": {
          "type": "integer",
          "minimum": 1
        },
        "issueUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "repository",
        "branch",
        "baseSha",
        "allowedPaths",
        "objective",
        "requiresHumanApproval"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "repository": {
          "const": "Cabatoy/AI-Agent-Lab-Project-Initialization-Architecture-Blueprint"
        },
        "branch": {
          "type": "string",
          "pattern": "^feature/[a-z0-9-]+(?:/[a-z0-9-]+)*$",
          "maxLength": 120
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^tools/dev-handoff/(?:[a-z0-9-]+/)*[a-z0-9.-]+\\.(?:md|mjs|json)$"
          }
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Short curated display-only text; not executable instructions"
        },
        "requiresHumanApproval": {
          "const": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "executionAllowed",
        "signature"
      ],
      "properties": {
        "status": {
          "const": "unsigned"
        },
        "executionAllowed": {
          "const": false
        },
        "signature": {
          "type": "null"
        }
      }
    }
  }
}
